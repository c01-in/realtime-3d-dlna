MEDIA_DIR=/path/to/videos
DATA_DIR=./data
DLNA_PORT=8200
DLNA_NAME=Realtime 3D DLNA
# keep-warm preloads the model. release-idle frees it after 30 minutes without playback.
DLNA_RESOURCE_MODE=keep-warm
# Optional. Use the host's LAN IP if automatic interface detection picks the wrong address.
DLNA_LAN_IP=
GPU_DEVICE=0
